+
+static PARTITION* _FAT_xts_partition (const char* name) {
+	const devoptab_t *devops;
+	if (!name)
+		return NULL;
+	devops = GetDeviceOpTab (name);
+	if (!devops || devops->open_r != dotab_fat.open_r)
+		return NULL;
+	return (PARTITION*)devops->deviceData;
+}
+
+bool fatFlush (const char* name) {
+	PARTITION* partition = _FAT_xts_partition (name);
+	FILE_STRUCT* file;
+	bool ok = true;
+	if (!partition)
+		return false;
+	_FAT_lock(&partition->lock);
+	for (file = partition->firstOpenFile; file; file = file->nextOpenFile) {
+		if (_FAT_syncToDisc (file) != 0)
+			ok = false;
+	}
+	if (!_FAT_partition_flush (partition))
+		ok = false;
+	_FAT_unlock(&partition->lock);
+	return ok;
+}
+
+int fatFileExtent (const char* path, uint32_t* firstSector, uint32_t* numSectors, uint32_t* bytesPerSector) {
+	PARTITION* partition = _FAT_xts_partition (path);
+	DIR_ENTRY entry;
+	uint32_t cluster, next, clusters = 0, size;
+	int ret = 0;
+	if (!partition)
+		return -1;
+	if (strchr (path, ':') != NULL)
+		path = strchr (path, ':') + 1;
+	_FAT_lock(&partition->lock);
+	if (!_FAT_directory_entryFromPath (partition, &entry, path, NULL) || _FAT_directory_isDirectory (&entry)) {
+		_FAT_unlock(&partition->lock);
+		return -1;
+	}
+	cluster = _FAT_directory_entryGetCluster (partition, entry.entryData);
+	size = u8array_to_u32 (entry.entryData, DIR_ENTRY_fileSize);
+	if (!_FAT_fat_isValidCluster (partition, cluster) || size == 0) {
+		_FAT_unlock(&partition->lock);
+		return -2;
+	}
+	if (firstSector)
+		*firstSector = _FAT_fat_clusterToSector (partition, cluster);
+	for (;;) {
+		clusters++;
+		next = _FAT_fat_nextCluster (partition, cluster);
+		if (next == CLUSTER_EOF)
+			break;
+		if (next != cluster + 1) {   // not contiguous (or a broken chain)
+			ret = -2;
+			break;
+		}
+		cluster = next;
+	}
+	if (ret == 0 && (uint64_t)clusters * partition->bytesPerCluster < size)
+		ret = -2;
+	if (numSectors)
+		*numSectors = (size + partition->bytesPerSector - 1) / partition->bytesPerSector;
+	if (bytesPerSector)
+		*bytesPerSector = partition->bytesPerSector;
+	_FAT_unlock(&partition->lock);
+	return ret;
+}
